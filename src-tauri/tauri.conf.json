{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Helix",
  "version": "0.1.8",
  "identifier": "com.helix.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Helix",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "maximized": true,
        "center": true,
        "backgroundColor": "#FCFBF9"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "AI coding assistant",
    "longDescription": "Helix — AI coding assistant with a native Hermes agent gateway.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/hermes-runtime/python/": "hermes-runtime/python/"
    }
  }
}
