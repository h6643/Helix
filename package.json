{
  "name": "helix",
  "version": "0.2.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "build": "next build --webpack && robocopy .next\\static .next\\standalone\\.next\\static /E /NFL /NDL && robocopy public .next\\standalone\\public /E /NFL /NDL",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "electron": "electron .",
    "electron:dev": "concurrently \"next dev --webpack -p 3000\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "next build --webpack && powershell -File scripts/build-hermes-runtime.ps1 && set CSC_IDENTITY_AUTO_DISCOVERY=false && set ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ && electron-builder",
    "electron:build:fast": "next build --webpack && powershell -File scripts/build-hermes-runtime.ps1 && set CSC_IDENTITY_AUTO_DISCOVERY=false && set ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ && electron-builder --win --x64",
    "electron:preview": "next build --webpack && powershell -File scripts/build-hermes-runtime.ps1 && set CSC_IDENTITY_AUTO_DISCOVERY=false && set ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ && electron-builder --dir"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.15",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-slot": "^1.2.3",
    "@uiw/codemirror-extensions-langs": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "imapflow": "^1.6.5",
    "lucide-react": "^0.525.0",
    "mailparser": "^3.9.14",
    "next": "^16.1.1",
    "node-pty": "^1.1.0",
    "nodemailer": "^9.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "concurrently": "^10.0.3",
    "electron": "43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "eslint-plugin-import": "^2.32.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "unified": "^11.0.5",
    "wait-on": "^9.0.10"
  }
}
